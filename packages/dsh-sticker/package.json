{
  "name": "dsh-lynn-sticker",
  "version": "1.2.1",
  "description": "DeepSeek Harness bundle that lets agents send Lynn-chan stickers inline, loading the media from sticker.stv.pm with minimal model context cost.",
  "type": "module",
  "license": "CC-BY-4.0",
  "author": "Steven Lynn (https://x.com/Stv_Lynn)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stvlynn/sticker.git",
    "directory": "packages/dsh-sticker"
  },
  "homepage": "https://github.com/stvlynn/sticker/tree/main/packages/dsh-sticker",
  "bugs": {
    "url": "https://github.com/stvlynn/sticker/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "sticker",
    "lynn",
    "agent",
    "mcp",
    "chat"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
